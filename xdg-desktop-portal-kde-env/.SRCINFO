pkgbase = xdg-desktop-portal-kde-env
	pkgdesc = Pins XDG_CURRENT_DESKTOP=KDE for xdg-desktop-portal so it selects the KDE backend (fixes GlobalShortcuts-dependent apps like ghostty quick terminal)
	pkgver = 1
	pkgrel = 1
	url = https://github.com/sharunkumar/pkgbuilds
	install = xdg-desktop-portal-kde-env.install
	arch = any
	license = custom:meta
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-kde
	source = kde-desktop.conf
	sha256sums = SKIP

pkgname = xdg-desktop-portal-kde-env
